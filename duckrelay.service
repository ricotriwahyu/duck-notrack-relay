[Unit]
Description=zexrtw API Relay for Radxa and 9router
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/duckrelay
ExecStart=/opt/duckrelay/.venv/bin/python main.py
Restart=always
RestartSec=5
EnvironmentFile=-/opt/duckrelay/.env
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
