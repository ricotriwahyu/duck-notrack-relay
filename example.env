# Duck.ai Web Relay Environment Configuration
# Bearer token required on /v1/* endpoints. Leave empty for open access.
DUCKAI_API_KEY=

# Duck.ai host (default https://duck.ai)
DUCKAI_BASE=https://duck.ai

# Public URL of this relay. Used to build image links returned to clients.
PUBLIC_BASE_URL=http://localhost:8080

# Proxy Pool (comma-separated). Rotates on ban (418 ERR_BN_LIMIT).
# Leave empty to connect directly.
# DUCKAI_PROXIES=http://user:pass@host1:port,socks5://host2:port
DUCKAI_PROXIES=

# Page warmup timing in seconds
DUCKAI_WARM_MIN=2.0
DUCKAI_WARM_MAX=7.0
DUCKAI_PREWARM=1

# Chromium executable path. Leave commented for auto-detection across Windows / Radxa Linux.
# Linux / Radxa: /usr/bin/chromium
# DUCKAI_CHROME_PATH=/usr/bin/chromium

# Default model when omitted by caller:
# Available Free Models:
#   gpt-6-luna (Default, OpenAI GPT-6 Luna)
#   gpt-5.4-mini (OpenAI GPT-5.4 mini)
#   claude-haiku-4-5 (Anthropic Claude Haiku 4.5)
#   mistral-small-2603 (Mistral Small 4)
#   tinfoil/gpt-oss-120b (gpt-oss 120B)
#   tinfoil/gemma4-31b (Gemma 4 31B)
#   zexrtw (Uncensored AI; old zexrtw-uncensored remains accepted as an alias)
DUCKAI_MODEL=gpt-6-luna

# "1" = fresh session each turn (stateless). "0" = reuse session (fast delta typing).
DUCKAI_NEW_CHAT=0

# Server port
PORT=8080

# Experimental tool routing
DUCKAI_TOOL_ROUTING=0
